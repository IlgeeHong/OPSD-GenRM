# Copy this file to opsd_genrm_recipes/credentials.env and fill in your own values:
#   cp opsd_genrm_recipes/credentials.env.example opsd_genrm_recipes/credentials.env
# credentials.env is git-ignored. Variables already set in the environment
# are also picked up, so this file is optional.

# Weights & Biases (https://wandb.ai/authorize). If empty, logs go to the console only.
WANDB_API_KEY=
# Optional W&B team/entity; defaults to your personal account.
WANDB_ENTITY=

# Hugging Face (https://huggingface.co/settings/tokens). Only needed for gated
# models/datasets or if you hit anonymous rate limits.
HF_TOKEN=
